#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
char str[100]; // Array to store the user's string
int choice;

// Ask the user for the string once at the beginning
printf("Enter a string: ");
scanf("%s", str); // Takes a single word input

while (1) {
// Display the Menu
printf("\n--- STRING OPERATIONS MENU ---\n");
printf("1. Convert to Uppercase\n");
printf("2. Convert to Lowercase\n");
printf("3. Reverse the String\n");
printf("4. Find Length\n");
printf("5. Change the Input String\n");
printf("6. Exit\n");
printf("Enter your choice (1-6): ");
scanf("%d", &choice);

// Process the choice using switch-case
switch (choice) {

case 1: {
printf("Uppercase: ");
for (int i = 0; str[i] != '\0'; i++) {
printf("%c", toupper(str[i]));
}
printf("\n");
break;
}
case 2: {
printf("Lowercase: ");
for (int i = 0; str[i] != '\0'; i++) {
printf("%c", tolower(str[i]));
}
printf("\n");
break;
}
case 3: {
printf("Reversed: ");
int len = strlen(str);
for (int i = len - 1; i >= 0; i--) {
printf("%c", str[i]); // Print backwards from the last character
}
printf("\n");
break;
}
case 4: {

printf("Length of string: %d\n", (int)strlen(str));
break;
}
case 5: {
printf("Enter new string: ");
scanf("%s", str);
break;
}
case 6: {
printf("Exiting program. Goodbye!\n");
return 0; // Ends the program
}
default: {
printf("Invalid choice! Please select between 1 and 6.\n");
}
}
}
return 0;
}
