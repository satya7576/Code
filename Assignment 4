#include <stdio.h>

int main()
{
    int i, j;
    int a[3][3] = {
        {1, 0, 1},
        {4, 5, 6},
        {1, 2, 3}
    };
    int b[3][3] = {
        {1, 1, 1},
        {2, 3, 1},
        {1, 5, 1}
    };
    int sum[3][3];

    for(i = 0; i < 3; i++)
    {
        for(j = 0; j < 3; j++)
        {
            sum[i][j] = a[i][j] + b[i][j];
        }
    }

    printf("Addition of two matrices: \n");

    // --- Added code to print the result and end main() ---
    for(i = 0; i < 3; i++)
    {
        for(j = 0; j < 3; j++)
        {
            printf("%d\t", sum[i][j]);
        }
        printf("\n");
    }

    return 0;
}
